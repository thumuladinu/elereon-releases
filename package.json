    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "antd": "^5.14.0",
    "apexcharts": "^3.27.1",
    "axios": "^1.6.2",
    "clipboard-polyfill": "^4.0.2",
    "customize-cra": "^1.0.0",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^2.5.2",
    "moment": "^2.30.1",
    "papaparse": "^5.5.2",
    "pdfjs-dist": "^4.0.379",
    "react": "^19.2.8",
    "react-apexcharts": "^1.3.9",
    "react-barcode": "^1.5.3",
    "react-dom": "^19.2.8",
    "react-redux": "^9.0.4",
    "react-router-dom": "^5.3.4",
    "react-scripts": "4.0.3",
    "react-to-print": "^3.0.5",
    "runes2": "^1.1.3",
